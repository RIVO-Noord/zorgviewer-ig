@startuml

skinparam node {
  fontColor<<future>> Gray
  borderColor<<future>> LightGray
}
skinparam component {
  fontColor<<future>> Gray
  borderColor<<future>> LightGray
}

cloud "..." {
 [Zorgviewer]
 [Zorgpad] <<future>>
 [Toestemming, Addressering] <<internal>>
}

node "Bronsysteem direct" as bst1 {
 [Zorgviewer Host] as bst1_host
 [Authenticatie] as bst1_auth
 [Bronsysteem ontsluiting] as bst1_bso
 [Bronsysteem, Logging] as bst1_bal
 [bst1_host]-->[bst1_bal]
 [bst1_bso]-->[bst1_bal]
}
note top of bst1 : E.g. een Epic huis:\n* Bronsysteem ontsluiting = IRIS of Rhapsody\n* Zorgviewer Host = Hyperspace\n* Bronsysteem = Epic

node "Bronsysteem via Platform" as bst2 {
 [Zorgviewer Host] as bst2_host <<Meerdere>>
 [Authenticatie] as bst2_auth <<Meerdere>>
 [Bronsysteem ontsluiting] as bst2_bso <<Platform>>
 [Bronsysteem, Logging] as bst2_bal <<Meerdere>>
 [bst2_bso]-->[bst2_bal]
 [bst2_host]-->[bst2_bal]
}
note bottom of bst2 : E.g. een Chipsoft of Topicus huis:\n* Zorgviewer Host = HiX of VIPLive\n* Authenticatie = Zorgplatform of VIPLive Auth\n* Bronsysteem ontsluiting = Zorgplatform of VIPLive

node "Zorgviewer Host Los" as bst3 <<future>> {
 [Zorgviewer Host] as bst3_host <<future>>
 [Authenticatie] as bst3_auth <<future>>
}

[bst1_host]-u->[Zorgviewer] :  1. opstart
[bst2_host]-u->[Zorgviewer] : 1. opstart
[bst3_host]..>[Zorgviewer] : 1. opstart
[Zorgviewer]-d->[bst1_auth] : 2. identity
[Zorgviewer]..>[bst3_auth] : 2. identity
[Zorgviewer]-d->[bst2_auth] : 2. identity
[Zorgviewer]-u->[Toestemming, Addressering] : 3. endpoints
[Zorgviewer]->[bst1_bso] : 4. bevragen
[Zorgviewer]->[bst2_bso] : 4. bevragen
[Zorgviewer]-u->[Zorgpad] : 5. filters
@enduml